#!/bin/bash

echo -e "Hello!!This program will run MyLyapunovProject with pmap for you.\nEnter the name of the I/O directory."$
read where
cd $where

echo -e "create job list? (y/n)"
read ans 
if [ "$ans" == 'y' ]
   then
   julia "/home/anegi/MyLyapunovProject/LyapunovExponents/job/create_jobs.jl"
fi

echo "Should I update the available computer list? (y/n)"
read ans
if [ "$ans" == 'y' ]
   then
   /home/anegi/complist/cinit
fi

echo "Proceed with running the job on ssh? (y/n)?"
read ans
if [ "$ans" == 'y' ]
    then
     echo "ENTER number of workers per job-group"
     read num_workers
     echo "Enter the iteration over jobs"
     read start_job stop_job job_step

     for (( c=$start_job; c<=$stop_job; c+=$job_step ))
	do 
        yy = "(($c + $job_step - 1))"
        echo $yy 
   	#julia --project="/home/anegi/MyLyapunovProject/Project_updated_3/ssh/" "/home/anegi/MyLyapunovProject/Project_updated_3/ssh/main.jl" $num_workers $c $c+$job_step-1
	done

      
fi



